# Plantilla de variables de entorno de GRCU Manager.
# Copiar este archivo como ".env" (en la misma carpeta que manage.py) y completar los valores.
# El archivo ".env" real NO se sube al repositorio: pedirlo a los docentes / responsables del proyecto.

# --- Obligatorias ---
SECRET_KEY=reemplazar-por-una-clave-larga-y-secreta
GOOGLE_CLIENT_ID=reemplazar-por-el-client-id
GOOGLE_CLIENT_SECRET=reemplazar-por-el-client-secret

# --- Opcionales (valores recomendados para desarrollo) ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Solo si se activa PostgreSQL en settings.py (ver el manual) ---
DB_NAME=grcu_db
DB_USER=usuario
DB_PASSWORD=contraseña
DB_HOST=localhost
DB_PORT=5432
